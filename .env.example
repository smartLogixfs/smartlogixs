# SmartLogix - variables de entorno
# Copiar a .env: cp .env.example .env

# === Postgres - DB-per-service ===
POSTGRES_INVENTARIO_DB=inventario
POSTGRES_INVENTARIO_USER=inventario
POSTGRES_INVENTARIO_PASSWORD=inventario_dev_pass

POSTGRES_PEDIDO_DB=pedido
POSTGRES_PEDIDO_USER=pedido
POSTGRES_PEDIDO_PASSWORD=pedido_dev_pass

POSTGRES_ENVIO_DB=envio
POSTGRES_ENVIO_USER=envio
POSTGRES_ENVIO_PASSWORD=envio_dev_pass

POSTGRES_USUARIO_DB=usuario
POSTGRES_USUARIO_USER=usuario
POSTGRES_USUARIO_PASSWORD=usuario_dev_pass

# === JWT ===
JWT_SECRET=change-me-in-production-min-32-chars-long-secret

# === Hosts ===
# Modificar /etc/hosts (linux/mac) o C:\Windows\System32\drivers\etc\hosts (windows):
#   127.0.0.1 app.smartlogix.localhost
#   127.0.0.1 api.smartlogix.localhost
#   127.0.0.1 bff.smartlogix.localhost
#   127.0.0.1 traefik.smartlogix.localhost
# (en Linux *.localhost suele resolver automaticamente; en Windows hace falta agregarlo)
