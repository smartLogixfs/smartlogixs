{
  "$schema": "https://www.krakend.io/schema/v2.9/krakend.json",
  "version": 3,
  "name": "smartlogix-gateway",
  "port": 8080,
  "timeout": "10s",
  "cache_ttl": "0s",
  "output_encoding": "json",

  "extra_config": {
    "router": {
      "return_error_msg": true
    },
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    }
  },

  "endpoints": [
    {
      "endpoint": "/health",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/health",
          "encoding": "no-op",
          "host": ["http://bff:3000"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/{path}",
      "method": "POST",
      "input_headers": ["Authorization", "Content-Type"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/auth/{path}",
          "encoding": "no-op",
          "host": ["http://bff:3000"]
        }
      ]
    },
    {
      "endpoint": "/api/usuarios/login",
      "method": "POST",
      "input_headers": ["Authorization", "Content-Type"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/usuarios/login",
          "encoding": "no-op",
          "host": ["http://bff:3000"]
        }
      ]
    },
    {
      "endpoint": "/api/inventario/{path}",
      "method": "GET",
      "input_headers": ["Authorization", "Content-Type"],
      "output_encoding": "no-op",
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://ms-auth:8081/.well-known/jwks.json",
          "disable_jwk_security": true,
          "roles_key": "scope",
          "roles": ["read:inventario"]
        }
      },
      "backend": [
        {
          "url_pattern": "/inventario/{path}",
          "encoding": "no-op",
          "host": ["http://bff:3000"]
        }
      ]
    },
    {
      "endpoint": "/api/inventario/{path}",
