# Frontend (Vite) - variables de entorno
# Copiar a .env:  cp .env.example .env
#
# IMPORTANTE: Vite solo expone al cliente las variables con prefijo VITE_,
# y las inlina en el bundle EN TIEMPO DE BUILD. Para `npm run dev` se leen
# automáticamente desde frontend/.env

# Base del API (gateway/BFF). Si se omite, el frontend usa '/api' (proxy de nginx/vite).
VITE_API_BASE=/api

# API key de Google Gemini para el AI Hub (optimizador de ruta + chatbot).
# Si se deja vacía, el AI Hub funciona en modo simulado (sin llamadas externas).
VITE_GEMINI_API_KEY=

# --- Microsoft Entra ID (Azure AD) / MSAL ---
# Ver docs/azure/entra-msal-setup.md para obtener/crear estos valores.
VITE_AZURE_TENANT_ID=<tenant-id>
VITE_AZURE_CLIENT_ID=<client-id>
VITE_AZURE_REDIRECT_URI=http://localhost:3000
# Scope de NUESTRA API (no 'User.Read'), para que el access token tenga aud = la API.
VITE_AZURE_API_SCOPE=api://<client-id>/access_as_user
